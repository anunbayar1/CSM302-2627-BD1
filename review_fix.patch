From: baaskan <baaskan@local>
Date: Tue, 17 Nov 2026 20:15:43 +0800
Subject: [PATCH 7/9] home: live mini buffer in the header

---
 src/ui/home.html | 109 +++++++++++++++++++++++++++++++++++++++++------
 1 file changed, 96 insertions(+), 13 deletions(-)

diff --git a/src/ui/home.html b/src/ui/home.html
index 4c282fe..22b7704 100644
--- a/src/ui/home.html
+++ b/src/ui/home.html
@@ -22,33 +22,58 @@
 html,body{height:100%}
 body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 var(--sans);display:flex;flex-direction:column}
 main{width:100%;max-width:1180px;margin:auto;padding:clamp(14px,3vh,48px) 24px}
-.head{display:flex;align-items:center;gap:18px;margin-bottom:clamp(16px,3vh,30px)}
-.head img{height:clamp(56px,8vh,78px)}
+.head{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:32px;align-items:center;margin-bottom:clamp(16px,3vh,34px)}
+.lead{margin:10px 0 0;color:var(--muted);font-size:17px;max-width:30em}
+.lead b{color:var(--ink);font-weight:600}
+/* live mini buffer: the one moving thing on the page */
+.demo{background:#1f2a3d;border-radius:18px;padding:18px 20px 14px;color:#c9d3e3}
+.lane{display:flex;align-items:center;gap:12px}
+.who{flex:none;width:44px;height:44px;border-radius:12px;display:grid;place-items:center;font:600 14px var(--mono);transition:background .2s,color .2s}
+.who.p{background:#174a36;color:#a6f0cc} .who.c{background:#2a3d73;color:#c9d6ff}
+.who.wait{background:#5a3f0c;color:#ffd68a}
+.ring{flex:1;display:grid;grid-template-columns:repeat(6,1fr);gap:6px}
+.slot{height:clamp(40px,6.5vh,58px);border-radius:9px;border:2px dashed #3d4c66;background:#2b3850;display:grid;place-items:center;font:600 17px var(--mono);color:#1a2233;position:relative}
+.slot.on{background:#fff4dc;border:2px solid #f2b445;animation:pop .35s ease-out}
+.slot.out{animation:drop .35s ease-in}
+.slot i{position:absolute;bottom:-17px;font:500 10.5px var(--mono);color:#7d8aa3;font-style:normal}
+.slot.in-at::after,.slot.out-at::before{position:absolute;font:600 10.5px var(--mono);padding:0 6px;border-radius:999px}
+.slot.out-at::before{content:"out";top:-19px;background:#2a3d73;color:#c9d6ff}
+.slot.in-at::after{content:"in";bottom:-19px;background:#174a36;color:#a6f0cc;z-index:1}
+@keyframes pop{from{transform:scale(.8)}to{transform:none}}
+@keyframes drop{from{transform:scale(1.06)}to{transform:none}}
+.slot b{font-weight:600}
+.vals{display:flex;gap:18px;margin-top:22px;font:500 13px var(--mono);color:#8f9bb0}
+.vals b{font-weight:600;color:#e6ebf2;margin-left:6px}
+.vals .z b{color:#ff8a80}
+.steps{display:flex;flex-wrap:wrap;gap:4px 6px;margin-top:10px;font:500 12.5px var(--mono);color:#6f7d96}
+.steps span{padding:2px 7px;border-radius:6px;transition:background .12s,color .12s}
+.steps span.hot{background:#e6ebf2;color:#1a2233}
+@media (max-width:900px){.head{grid-template-columns:1fr}}
 .kicker{font:500 15px var(--sans);color:var(--muted)}
-h1{font-size:clamp(30px,3.6vw,46px);line-height:1.08;margin:2px 0 0;letter-spacing:-.025em;font-weight:700}
+h1{font-size:clamp(28px,min(3.6vw,5.4vh),46px);line-height:1.08;margin:2px 0 0;letter-spacing:-.025em;font-weight:700}
 .flow{display:flex;align-items:center;justify-content:flex-start;gap:10px;flex-wrap:wrap;margin:0 0 clamp(16px,3vh,28px);font:500 14px var(--mono)}
 .flow .n{padding:6px 12px;border-radius:999px}
 .flow .p{background:var(--green-soft);color:var(--green)} .flow .b{background:var(--amber-soft);color:var(--amber)} .flow .c{background:var(--blue-soft);color:var(--blue)}
 .flow .s{color:var(--muted);font-weight:500}
 .flow .ar{color:var(--muted)}
 .cards{display:grid;grid-template-columns:1fr 1fr;gap:22px}
-.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px;display:flex;flex-direction:column;text-decoration:none;color:inherit;transition:transform .15s,border-color .15s}
+.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:clamp(14px,2.4vh,22px);display:flex;flex-direction:column;text-decoration:none;color:inherit;transition:transform .15s,border-color .15s}
 .card:hover{border-color:var(--ink)}
 .card:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
-.pic{width:100%;aspect-ratio:400/170;max-height:22vh;border-radius:14px;margin-bottom:16px;display:block;overflow:hidden}
+.pic{width:100%;aspect-ratio:400/170;max-height:17vh;border-radius:14px;margin-bottom:16px;display:block;overflow:hidden}
 .top{display:flex;align-items:center;justify-content:space-between;gap:10px}
 .badge{font:600 12.5px var(--sans);padding:4px 10px;border-radius:999px}
 .badge.py{background:var(--amber-soft);color:var(--amber)}
 .badge.c{background:var(--green-soft);color:var(--green)}
 .card h2{margin:10px 0 4px;font-size:23px}
 .card p{margin:0 0 12px;color:var(--muted)}
-.tags{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 18px}
+.tags{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 clamp(10px,2vh,18px)}
 .tags span{font-size:13px;padding:4px 10px;border-radius:8px;background:var(--bg);border:1px solid var(--line)}
 .go{margin-top:auto;display:flex;align-items:center;justify-content:center;gap:8px;background:var(--mail);color:#fff;border-radius:12px;padding:12px 16px;font-weight:700}
 .py .pic{background:#eef1fc}.c .pic{background:#111827}
 .card.c .go{background:var(--ink);color:var(--card)}
 .warn{display:none;margin:0 0 12px;padding:10px 12px;border-radius:10px;background:var(--amber-soft);color:var(--amber);font-size:14px;font-weight:600}
-.cli{margin-top:clamp(16px,3vh,26px);display:flex;align-items:center;justify-content:flex-start;gap:10px;flex-wrap:wrap;color:var(--muted);font-size:14px}
+.cli{margin-top:clamp(10px,2.4vh,26px);display:flex;align-items:center;justify-content:flex-start;gap:10px;flex-wrap:wrap;color:var(--muted);font-size:14px}
 code{font:13px var(--mono);background:var(--card);border:1px solid var(--line);padding:4px 9px;border-radius:7px;white-space:nowrap;color:var(--ink)}
 footer{color:var(--muted);font-size:13px;text-align:center;padding:10px 16px 16px}
 /* little animations */
@@ -69,13 +94,17 @@ footer{color:var(--muted);font-size:13px;text-align:center;padding:10px 16px 16p
     <div>
       <div class="kicker">F.CSM302 Үйлдлийн систем, бие даалт 1, V-1-12</div>
       <h1>Producer–Consumer бодлого</h1>
+      <p class="lead">Хязгаарлагдмал буферийг <b>empty</b>, <b>full</b> семафор, <b>mutex</b>-ээр хамгаалах арга. Хоёр хэлбэрийн аль нэгийг сонгоно уу.</p>
+    </div>
+    <div class="demo" aria-label="Буферийн жишээ: producer item хийж, consumer авч байна">
+      <div class="lane">
+        <div class="who p" id="dP">P1</div>
+        <div class="ring" id="ring"></div>
+        <div class="who c" id="dC">C1</div>
+      </div>
+      <div class="vals"><span id="vE">empty<b>6</b></span><span id="vF">full<b>0</b></span><span id="vM">mutex<b>free</b></span></div>
+      <div class="steps" id="steps"></div>
     </div>
-  </div>
-
-  <div class="flow">
-    <span class="n p">producer</span><span class="ar">→ wait(empty) → lock →</span>
-    <span class="n b">buffer[N]</span>
-    <span class="ar">→ unlock → signal(full) →</span><span class="n c">consumer</span>
   </div>
 
   <div class="cards">
@@ -130,6 +159,60 @@ footer{color:var(--muted);font-size:13px;text-align:center;padding:10px 16px 16p
 </main>
 <footer>Серверийг унтраах: терминал дээр <b>Ctrl+C</b></footer>
 <script>
+/* a tiny picture of the algorithm (not the real engine): 6 slots, one producer, one consumer */
+(() => {
+  const N = 6, slots = Array(N).fill(null), ring = document.getElementById("ring");
+  let inI = 0, outI = 0, empty = N, full = 0, busy = false;
+  ring.innerHTML = slots.map((_, i) => `<div class="slot"><b></b><i>${i}</i></div>`).join("");
+  const cells = [...ring.children], $ = id => document.getElementById(id);
+  const P = ["wait(empty)", "lock", "buffer[in] = item", "unlock", "signal(full)"];
+  const C = ["wait(full)", "lock", "item = buffer[out]", "unlock", "signal(empty)"];
+  function marks(){
+    cells.forEach((c, i) => { c.classList.toggle("in-at", i === inI); c.classList.toggle("out-at", i === outI); });
+    $("vE").innerHTML = `empty<b>${empty}</b>`; $("vF").innerHTML = `full<b>${full}</b>`;
+    $("vE").className = empty ? "" : "z"; $("vF").className = full ? "" : "z";
+    if (empty) $("dP").classList.remove("wait");
+    if (full) $("dC").classList.remove("wait");
+  }
+  function show(seq, hot){ $("steps").innerHTML = seq.map((t, i) => `<span class="${i === hot ? "hot" : ""}">${t}</span>`).join("→"); }
+  const sleep = ms => new Promise(r => setTimeout(r, ms));
+  async function act(isP){
+    const seq = isP ? P : C, who = isP ? $("dP") : $("dC");
+    if ((isP ? empty : full) === 0){ who.classList.add("wait"); show(seq, 0); return; }
+    who.classList.remove("wait"); busy = true;
+    for (let k = 0; k < seq.length; k++){
+      show(seq, k);
+      $("vM").innerHTML = `mutex<b>${k >= 1 && k <= 2 ? who.textContent : "free"}</b>`;
+      if (k === 0){ if (isP) empty--; else full--; }
+      if (k === 2){
+        const c = cells[isP ? inI : outI];
+        if (isP){ slots[inI] = 1 + Math.floor(Math.random() * 99); c.firstChild.textContent = slots[inI];
+                  c.classList.add("on"); inI = (inI + 1) % N; }
+        else { slots[outI] = null; c.firstChild.textContent = ""; c.classList.remove("on"); c.classList.add("out");
+               setTimeout(() => c.classList.remove("out"), 400); outI = (outI + 1) % N; }
+      }
+      if (k === 4){ if (isP) full++; else empty++; }
+      marks(); await sleep(170);
+    }
+    busy = false;
+  }
+  marks(); show(P, -1);
+  if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
+  let tick = 0;
+  (async function loop(){
+    for (;;){
+      if (!document.hidden && !busy){
+        tick++;
+        // phases: the producer is faster for a while (buffer fills), then the consumer (it empties)
+        const pFast = Math.floor(tick / 14) % 2 === 0;
+        const isP = Math.random() < (pFast ? .72 : .28);
+        await act(isP);
+      }
+      await sleep(260);
+    }
+  })();
+})();
